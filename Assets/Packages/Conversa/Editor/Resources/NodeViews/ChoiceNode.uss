#choice-node {
    width: 200px;
    padding: 10px;
    background-color: rgb(66, 66, 66);
}

ChoiceNodeView Label#actor {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    
    border-bottom-width: 1px;
    padding-bottom: 6px;
    border-bottom-color: rgb(255, 255, 255);
}

ChoiceNodeView Label#key {
    margin-top: 10px;
    margin-bottom: 5px;
    font-size: 12px;
    color: rgb(204, 204, 204);
}

ChoiceNodeView .option-list {
    border-bottom-width: 1px;
    padding-bottom: 6px;
    border-bottom-color: rgb(255, 255, 255);
}

